# DEMO-ONLY dummy values. Never put real secrets here. Copy to .env to override.
POSTGRES_SUPERUSER_PASSWORD=dummy-postgres-superuser-pw
AEGIS_OWNER_PASSWORD=dummy-aegis-owner-pw
AEGIS_APP_PASSWORD=dummy-aegis-app-pw
KEYCLOAK_ADMIN_PASSWORD=dummy-keycloak-admin-pw
OPA_TOKEN=dummy-opa-pep-token
AGENT_ALPHA_CLIENT_SECRET=dummy-agent-alpha-secret
AEGIS_AUDIT_SHIPPER_PASSWORD=dummy-aegis-shipper-pw
AEGIS_AUDITOR_PASSWORD=dummy-aegis-auditor-pw
AUDIT_SINK_ROOT_ACCESS_KEY=dummy-sink-root
AUDIT_SINK_ROOT_SECRET_KEY=dummy-sink-root-secret
AUDIT_SINK_SHIPPER_ACCESS_KEY=aegis-shipper
AUDIT_SINK_SHIPPER_SECRET_KEY=dummy-sink-shipper-secret
AUDIT_SINK_AUDITOR_ACCESS_KEY=aegis-auditor
AUDIT_SINK_AUDITOR_SECRET_KEY=dummy-sink-auditor-secret
# Optional real-model planner (ADR-10). Leave as deterministic unless you accept sending the synthetic
# demo documents to the Anthropic API. Put a real ANTHROPIC_API_KEY only in your untracked .env.
AEGIS_AGENT_PLANNER=deterministic
ANTHROPIC_API_KEY=
